# Базовый адрес API для сборки фронтенда.
# Пусто в разработке: vite проксирует /api на бэкенд, браузер видит один источник.
# Заполняется, когда собранный фронтенд лежит отдельно от API.
VITE_API_URL=

# Встроенный набор демо-данных вместо запросов к бэкенду.
# Включён по умолчанию, пока часть разделов не реализована на сервере:
# `off` отключает подмену и отправляет все запросы на настоящий API.
# Подробности и порядок отключения — в src/mocks/README.md.
VITE_DEMO_DATA=on
