#: accounts/authentication.py:18
msgid "Используйте заголовок Authorization: Bearer <token>."
msgstr "Authorization: Bearer <token> тақырыбын пайдаланыңыз."

#: accounts/authentication.py:31 accounts/views.py:103
msgid "Пользователь не найден или отключён."
msgstr "Пайдаланушы табылмады немесе өшірілген."

#: accounts/jwt.py:46
msgid "Токен недействителен или истёк."
msgstr "Токен жарамсыз немесе мерзімі өтіп кеткен."

#: accounts/jwt.py:49
msgid "Тип токена недействителен."
msgstr "Токен түрі жарамсыз."

#: accounts/models.py:11 accounts/serializers.py:11 specialists/models.py:11
msgid "Введите номер в международном формате, например +77001234567."
msgstr "Телефон нөмірін халықаралық форматта енгізіңіз, мысалы +77001234567."

#: accounts/models.py:18
msgid "Логин обязателен."
msgstr "Логин міндетті."

#: accounts/models.py:35
msgid "Для суперпользователя is_staff должен быть равен True."
msgstr "Суперпайдаланушы үшін is_staff мәні True болуы керек."

#: accounts/models.py:37
msgid "Для суперпользователя is_superuser должен быть равен True."
msgstr "Суперпайдаланушы үшін is_superuser мәні True болуы керек."

#: accounts/models.py:75
msgid "Активный филиал"
msgstr "Белсенді филиал"

#: accounts/otp.py:18
msgid "Сервис отправки кодов подтверждения не настроен."
msgstr "Растау кодтарын жіберу қызметі бапталмаған."

#: accounts/serializers.py:10 accounts/serializers.py:12
msgid "Введите номер телефона."
msgstr "Телефон нөмірін енгізіңіз."

#: accounts/serializers.py:23 accounts/serializers.py:24
msgid "Введите код подтверждения."
msgstr "Растау кодын енгізіңіз."

#: accounts/serializers.py:33
msgid "Refresh-токен не может быть пустым."
msgstr "Жаңарту токені бос болмауы керек."

#: accounts/serializers.py:34
msgid "Refresh-токен обязателен."
msgstr "Жаңарту токені міндетті."

#: accounts/views.py:32
msgid "Пользователь найден. Введите код для входа."
msgstr "Пайдаланушы табылды. Кіру үшін кодты енгізіңіз."

#: accounts/views.py:34
msgid "Новый пользователь. Аккаунт будет создан после подтверждения кода."
msgstr "Жаңа пайдаланушы. Аккаунт код расталғаннан кейін құрылады."

#: accounts/views.py:42
msgid "В режиме разработки принимается любой непустой код."
msgstr "Әзірлеу режимінде кез келген бос емес код қабылданады."

#: accounts/views.py:64
msgid "Код подтверждения неверен или истёк."
msgstr "Растау коды қате немесе мерзімі өтіп кеткен."

#: accounts/views.py:71
msgid "Аккаунт создан, вход выполнен."
msgstr "Аккаунт құрылды, жүйеге кірдіңіз."

#: accounts/views.py:73
msgid "Код подтверждён, вход выполнен."
msgstr "Код расталды, жүйеге кірдіңіз."

