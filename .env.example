# Скопируйте в .env и поправьте значения: cp .env.example .env
# Файл читают и docker compose, и Django внутри контейнера backend.

# --- База данных ---
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me

# --- Django ---
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173

# --- Frontend ---
VITE_DEMO_DATA=off
# Номер без плюса для ссылки WhatsApp в разделе поддержки
VITE_SUPPORT_PHONE=

# Опциональный webhook сервиса WhatsApp/рассылок. Получает JSON:
# {title, message, recipients}; может вернуть {success_count}.
CRM_CAMPAIGN_WEBHOOK_URL=
CRM_CAMPAIGN_WEBHOOK_TOKEN=
