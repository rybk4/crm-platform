# Скопируйте в .env и поправьте значения: cp .env.example .env
# Файл читают и docker compose, и Django внутри контейнера backend.

# --- База данных ---
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me

# --- Django ---
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173

# --- JWT ---
JWT_SECRET_KEY=change-me-use-at-least-32-random-bytes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
